+def _fix_dead_mask_rows(mask_mapping):
+    # Padded sliding-window queries can have no visible keys, causing NaN gradients
+    # in fused SDPA backward. Unmask only those dead rows; their outputs occur at pad
+    # positions and are discarded by last-valid-token pooling.
+    if not isinstance(mask_mapping, dict):
+        return mask_mapping
+    for key, mask in mask_mapping.items():
+        if not isinstance(mask, torch.Tensor):
+            continue
+        if mask.dtype == torch.bool:
+            mask_mapping[key] = mask | ~mask.any(dim=-1, keepdim=True)
+        elif mask.is_floating_point():
+            dead = (mask == torch.finfo(mask.dtype).min).all(dim=-1, keepdim=True)
+            mask_mapping[key] = mask.masked_fill(dead, 0)
+    return mask_mapping
+
